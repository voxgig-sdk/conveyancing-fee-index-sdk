          }
        }
        {
          bf: [
            "filterKey"
            "filterValue"
          ]
          co: {
            id: "POST /mcp/tools/compare_options"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/mcp/tools/compare_options"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "mcp"
            }
            {
              lit: "tools"
            }
            {
